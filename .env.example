# Optional: Configure ONE of these providers to enable live AI-generated formative feedback & Socratic defense.
# If left empty, the platform uses genuine dynamic code + test-diff diagnostics (no hardcoded bug templates).

# Option 1: Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI (or any OpenAI-compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Local Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

PORT=3000
